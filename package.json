{
  "name": "eaglepower",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:vite": "vite",
    "export:json": "node server/src/scripts/exportDbToJson.js",
    "build": "next build",
    "build:vite": "vite build",
    "start": "node server/src/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/src/index.js",
    "server:migrate": "node server/src/scripts/migrateLegacy.js",
    "server:backup": "node server/src/scripts/backupDb.js",
    "server:test": "node server/src/scripts/testApi.js",
    "test": "node --test tests/edge-proxy.test.mjs tests/hr-management.test.mjs tests/continuous-assessment-grading.test.mjs",
    "start:prod": "npm run build && node server/src/index.js",
    "deploy": "wrangler pages deploy out",
    "pages:build": "next build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.0"
  },
