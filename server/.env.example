PORT=5050
NODE_ENV=development
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_in_production
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Production: list only your exact HTTPS website origins, separated by commas.
# CORS_ORIGIN=https://eaglepower.pages.dev

# Use an absolute private persistent path in production.
# DB_PATH=/var/lib/eaglepower/eaglepower.db
# PAYSTACK_SECRET_KEY=configure_in_the_host_secret_store
# Simulation is opt-in and is always forbidden in production.
PAYSTACK_SANDBOX=false

# Persistent authoritative backend sends overdue fee reminders during 09:00-17:00 Africa/Lagos.
ENABLE_FEE_REMINDERS=false
WHATSAPP_BOT_ORIGIN=
# Set the same strong secret (at least 32 characters) on backend and bot.
WHATSAPP_SERVICE_KEY=
