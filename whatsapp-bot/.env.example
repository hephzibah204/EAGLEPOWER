# Eagle Power WhatsApp bot environment
NODE_ENV=production
ENABLE_WHATSAPP=true
AUTH_DIR=/data/auth_info
DB_PATH=/data/eaglepower.db
PORT=8080

# Generic authenticated send endpoint (/fee-reminders/send)
WHATSAPP_SERVICE_KEY=

# Weekly Executive Report: production data source (added 2026-11-26).
# Generate ONE long random key (32+ chars) and set the SAME value in both
# places: here as WEEKLY_REPORT_KEY, and on the Cloudflare Pages project
# `eaglepower` as the WEEKLY_REPORT_KEY secret. The bot fetches live
# aggregates from the portal and never reports from its local snapshot.
WEEKLY_REPORT_KEY=
PORTAL_BASE_URL=https://eaglepowerschools.com.ng
